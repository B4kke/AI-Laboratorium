# Valgfritt. Uten nøkler kjører appen fullt ut i deterministisk demomodus.
NVIDIA_API_KEY=
OPENCODE_ZEN_API_KEY=

# Påkrevd i produksjon for kortlevde, signerte rapportbevis. Minst 32 tegn.
REPORT_SIGNING_SECRET=

# Påkrevd hvis en ekstern provider-nøkkel er satt. Deles bare med godkjente
# brukere og sendes fra UI som Bearer-header. Minst 32 tegn i produksjon.
AI_LAB_ACCESS_TOKEN=

# Valgfri standardmodell. Modellkataloger oppdages ved kjøring.
NVIDIA_MODEL=
OPENCODE_ZEN_MODEL=

# NVIDIA-katalogen oppgir ikke pris i /models. Legg bare inn modell-ID-er du
# eksplisitt har bekreftet som gratis for kontoen, kommaseparert.
NVIDIA_CONFIRMED_FREE_MODELS=

# Sikker brukspolicy.
PROVIDER_FREE_ONLY=true
PROVIDER_REQUEST_TIMEOUT_MS=45000

# Senere persistent laboratoriedrift. Ikke påkrevd for Quick Duel.
DATABASE_URL=
APP_BASE_URL=http://localhost:3000
WORKER_CONCURRENCY=2
