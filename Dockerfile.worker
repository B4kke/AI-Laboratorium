FROM node:24-bookworm-slim
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable
WORKDIR /app
COPY . .
RUN pnpm install --frozen-lockfile
ENV NODE_ENV="production"
RUN groupadd --system --gid 1001 nodejs && useradd --system --uid 1001 --gid nodejs runner
USER runner
CMD ["pnpm", "--filter", "@ai-lab/runner", "worker"]
